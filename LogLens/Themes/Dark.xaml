<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="App.Bg"          Color="#1E1E1E" />
    <SolidColorBrush x:Key="App.BgAlt"       Color="#252526" />
    <SolidColorBrush x:Key="App.BgSunken"    Color="#171717" />
    <SolidColorBrush x:Key="App.Border"      Color="#3A3A3C" />
    <SolidColorBrush x:Key="App.Fg"          Color="#E4E4E4" />
    <SolidColorBrush x:Key="App.FgDim"       Color="#9A9A9A" />
    <SolidColorBrush x:Key="App.FgFaint"     Color="#6B6B6B" />
    <SolidColorBrush x:Key="App.Accent"      Color="#4C8DFF" />
    <SolidColorBrush x:Key="App.AccentDim"   Color="#2A4D8F" />
    <SolidColorBrush x:Key="App.Selection"   Color="#2F4F7F" />
    <SolidColorBrush x:Key="App.Hover"       Color="#2D2D30" />
    <SolidColorBrush x:Key="App.LogBg"       Color="#141414" />
    <SolidColorBrush x:Key="App.LogFg"       Color="#D6D6D6" />
    <SolidColorBrush x:Key="App.Gutter"      Color="#1B1B1B" />
    <SolidColorBrush x:Key="App.GutterFg"    Color="#5A5A5A" />
    <SolidColorBrush x:Key="App.Danger"      Color="#EF5350" />
    <SolidColorBrush x:Key="App.Warn"        Color="#FFB300" />
    <SolidColorBrush x:Key="App.Ok"          Color="#4CAF50" />
    <SolidColorBrush x:Key="App.FindHit"     Color="#7A5D00" />

    <!--
      Menus, context menus and popups use the OS system brushes, not our styles.
      Overriding the keys here is what keeps dropdowns from flashing white.
    -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}"           Color="#252526" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}"        Color="#252526" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}"       Color="#E4E4E4" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"        Color="#252526" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"    Color="#E4E4E4" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}"   Color="#3A3A3C" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}"    Color="#3A3A3C" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"         Color="#1E1E1E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"     Color="#E4E4E4" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"      Color="#2F4F7F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"  Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}"       Color="#7A7A7A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#33415C" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E4E4E4" />

</ResourceDictionary>
