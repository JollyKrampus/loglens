<Window x:Class="LogLens.Dialogs.IssuesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Issues" Height="760" Width="1240"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Bg}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Distinct problems, aggregated across every time they have been seen. Occurrences are grouped by a normalised signature — timestamps, ids, paths and numbers are masked — so one bug logged ten thousand times is one issue here." />

        <!-- severity filter + search -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left" Text="Show" Style="{StaticResource Dim}" Margin="0,0,8,0" />

            <ToggleButton DockPanel.Dock="Left" x:Name="FatalFilter" Margin="0,0,4,0" Padding="12,4"
                          Click="Filter_Changed" ToolTip="Fatal issues" />
            <ToggleButton DockPanel.Dock="Left" x:Name="ErrorFilter" Margin="0,0,4,0" Padding="12,4"
                          Click="Filter_Changed" ToolTip="Error issues" />
            <ToggleButton DockPanel.Dock="Left" x:Name="WarnFilter" Margin="0,0,14,0" Padding="12,4"
                          Click="Filter_Changed" ToolTip="Warning issues" />

            <CheckBox DockPanel.Dock="Left" x:Name="HideFiled" Content="Hide filed" Margin="0,0,12,0"
                      Click="Filter_Changed"
                      ToolTip="Hide issues that already have a Jira key recorded." />
            <CheckBox DockPanel.Dock="Left" x:Name="ShowIgnored" Content="Show ignored" Margin="0,0,14,0"
                      Click="Filter_Changed" />

            <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Margin="6,0,0,0" />
            <TextBox x:Name="SearchBox" TextChanged="Search_Changed"
                     ToolTip="Filter by title, signature or sample text" />
        </DockPanel>

        <!-- list + detail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="480" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="Grid" Grid.Column="0"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                      RowHeight="24" SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sev" Width="52" Binding="{Binding Severity}" />
                    <DataGridTextColumn Header="Count" Width="70"
                                        Binding="{Binding Count, StringFormat=N0}" />
                    <DataGridTextColumn Header="Title" Width="*" Binding="{Binding Title}" />
                    <DataGridTextColumn Header="Last seen" Width="130"
                                        Binding="{Binding LastSeenLocal, StringFormat='yyyy-MM-dd HH:mm'}" />
                    <DataGridTextColumn Header="Jira" Width="100" Binding="{Binding JiraKey}" />
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="Fatal">
                                <Setter Property="Foreground" Value="#FF8A8A" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                <Setter Property="Foreground" Value="#FF8A8A" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Warn">
                                <Setter Property="Foreground" Value="#FFC978" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Ignored}" Value="True">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

            <Border Grid.Column="2" Background="{DynamicResource App.BgAlt}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1" Padding="12">
                <Grid x:Name="DetailPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="DetailTitle" TextWrapping="Wrap" FontWeight="SemiBold"
                                   FontSize="13" Margin="0,0,0,8" />
                        <TextBlock x:Name="DetailFacts" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                   Margin="0,0,0,10" />
                    </StackPanel>

                    <TextBox Grid.Row="1" x:Name="DetailSample" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11.5"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" Margin="0,0,0,10" />

                    <StackPanel Grid.Row="2">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Jira key" />
                            <TextBox Grid.Column="1" x:Name="JiraKeyBox" Margin="0,0,6,0"
                                     LostFocus="JiraKey_LostFocus"
                                     ToolTip="Record the key once you have raised the ticket, e.g. PLAT-1234" />
                            <Button Grid.Column="2" Content="Open" Click="OpenJira_Click"
                                    ToolTip="Open this issue in Jira (needs a Jira URL in Settings)" />
                        </Grid>

                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <Button Content="Copy Jira ticket" Margin="0,0,3,0"
                                    Style="{StaticResource AccentButton}" Click="CopyJira_Click"
                                    ToolTip="Copy a ready-to-paste summary and description in Jira markup" />
                            <Button Content="Copy as plain text" Margin="3,0,0,0" Click="CopyPlain_Click" />
                        </UniformGrid>

                        <UniformGrid Columns="3">
                            <Button Content="Create in Jira…" Margin="0,0,3,0" Click="CreateInJira_Click"
                                    ToolTip="Open Jira's new-issue form with the summary pre-filled" />
                            <Button x:Name="IgnoreButton" Content="Ignore" Margin="3,0,3,0" Click="Ignore_Click"
                                    ToolTip="Hide this issue from the list without deleting its history" />
                            <Button Content="Delete" Margin="3,0,0,0" Click="Delete_Click" />
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource Dim}" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Open database folder" Margin="0,0,8,0" Click="OpenDbFolder_Click" />
                <Button Content="Export visible as CSV…" Margin="0,0,8,0" Click="Export_Click" />
                <Button Content="Close" Width="88" IsCancel="True" Style="{StaticResource AccentButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
