<Window x:Class="LogLens.Dialogs.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update LogLens" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource App.Bg}">

    <StackPanel Margin="18">

        <TextBlock x:Name="Headline" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"
                   Text="A newer LogLens is available" />
        <TextBlock x:Name="VersionLine" Style="{StaticResource Dim}" Margin="0,0,0,4" />
        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="The download is verified against the checksum published with the release before anything is replaced. Your workspace and issue database are untouched — only the .exe is swapped, right where it lives." />

        <ProgressBar x:Name="Progress" Height="10" Minimum="0" Maximum="1"
                     Visibility="Collapsed" Margin="0,0,0,6" />
        <TextBlock x:Name="StatusLine" Style="{StaticResource Dim}" Margin="0,0,0,10"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="NotesButton" Content="Release notes" Width="110" Margin="0,0,8,0"
                    Click="Notes_Click" />
            <Button x:Name="LaterButton" Content="Later" Width="88" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="InstallButton" Content="Update and restart" Width="150"
                    Style="{StaticResource AccentButton}" Click="Install_Click" />
        </StackPanel>
    </StackPanel>
</Window>
