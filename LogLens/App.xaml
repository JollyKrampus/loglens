<Application x:Class="LogLens.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LogLens.Core"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the theme and gets swapped at runtime. -->
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <c:InheritIfNullConverter x:Key="InheritIfNull" />
            <c:NullToTransparentConverter x:Key="NullToTransparent" />
            <c:BoolToWrapConverter x:Key="BoolToWrap" />
            <c:WrapToHScrollConverter x:Key="WrapToHScroll" />
            <c:BoolToVisibilityConverter x:Key="BoolToVis" />
            <c:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
            <c:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis" />
            <c:PositiveToVisibilityConverter x:Key="PositiveToVis" />
            <c:PositiveToVisibilityConverter x:Key="ZeroToVis" Invert="True" />
            <c:HexToBrushConverter x:Key="HexToBrush" />
            <c:LineNumberWidthConverter x:Key="LineNumberWidth" />
            <c:StringToFontFamilyConverter x:Key="StringToFontFamily" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
