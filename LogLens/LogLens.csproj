<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LogLens</AssemblyName>
    <RootNamespace>LogLens</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Regenerate with tools\New-AppIcon.ps1. Sets the exe, taskbar and window icon. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.5.1</Version>
    <InformationalVersion>1.5.0</InformationalVersion>
    <Product>LogLens</Product>
    <AssemblyTitle>LogLens - real-time log viewer</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--
      WFAC010 is the WinForms analyser insisting DPI be set via ApplicationHighDpiMode.
      This is a WPF app: the manifest is the correct place, and that property does not
      apply. WinForms is only here for the colour and font pickers.
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!--
      Do NOT set InvariantGlobalization. WPF's XmlLanguage.GetSpecificCulture()
      needs real ICU culture data; without it every binding throws during layout.
    -->
  </PropertyGroup>

  <!--
    WinForms is referenced only for the standard colour and font pickers. Its
    implicit usings collide with WPF (Brush, FontFamily, Timer, UserControl...),
    so drop them and reference those two types by their full names instead.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <!--
    Everything that doesn't touch WPF lives in LogLens.Core (models, tailing,
    issue store, updaterâ€¦) so the planned Avalonia app can share it. Sqlite comes
    in transitively through Core; its native e_sqlite3 still survives single-file
    publish because IncludeNativeLibrariesForSelfExtract is on.
  -->
  <ItemGroup>
    <ProjectReference Include="..\LogLens.Core\LogLens.Core.csproj" />
  </ItemGroup>

  <!--
    Shown almost immediately at startup and faded out when the main window paints.
    Covers the single-file extraction / JIT / workspace-load pause that otherwise
    looks like the app ignoring the double-click. Regenerate with
    tools\New-SplashImage.ps1.
  -->
  <ItemGroup>
    <SplashScreen Include="Assets\splash.png" />
  </ItemGroup>

</Project>
