<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Deliberately plain net8.0 with no UI framework: this is everything LogLens
      knows how to do, minus how it looks. The WPF app references it today; the
      Avalonia app (issue #1) references it tomorrow. Nothing in here may touch
      System.Windows.* — that is the whole point of the split.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LogLens</RootNamespace>
    <AssemblyName>LogLens.Core</AssemblyName>
    <Version>1.4.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

</Project>
